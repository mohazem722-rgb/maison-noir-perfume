# Browser-safe keys only. Never expose the service-role key with a VITE_ prefix.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Digits including country code; leave blank until the real number is confirmed.
VITE_WHATSAPP_NUMBER=

# Optional public hero film URL (same-origin path recommended for production).
# Empty uses the direct MP4 provided by the customer; never put credentials in this URL.
VITE_HERO_VIDEO_URL=

# Production HTTPS origin, e.g. your real custom domain. No trailing path or credentials.
# Leave empty on previews: preview pages are noindex and no production sitemap is invented.
VITE_SITE_URL=

# ----- Server only (Vercel Functions in /api). Never prefix these with VITE_. -----
# Used by /api/shop and /api/health. Set them in Vercel → Project → Settings → Environment Variables.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Paymob callback configuration for /api/payments/webhook.
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=

# Optional payment receipt notifications.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
